FROM volcengine/sandbox-fusion:server-20250609

# Keep things simple: use the system Python if available in the base image.
# If the base image does not contain Python/pip, please extend this Dockerfile
# to install them per your environment.

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

# Place source files directly under /workspace (flat layout) by copying
# from the react_baseline package in the repo.
COPY template_coding/react_baseline/server.py /workspace/server.py
COPY template_coding/react_baseline/agent.py /workspace/agent.py
COPY template_coding/react_baseline/llm.py /workspace/llm.py
COPY template_coding/react_baseline/tools /workspace/tools

# Runtime python dependencies
COPY template_coding/requirements.volc.txt /workspace/requirements.txt
RUN (python3 -m pip --version || pip --version) >/dev/null 2>&1 \
    && (python3 -m pip install -r /workspace/requirements.txt \
        || pip install -r /workspace/requirements.txt)

EXPOSE 7777

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "7777"]
